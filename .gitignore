# ── Entornos y cache ──────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/

# ── Secretos ──────────────────────────────────────────────────────
.env
*.env

# ── Claude ────────────────────────────────────────────────────────
.claude/
CLAUDE.md

# ── Documentos ────────────────────────────────────────────────────
# Los .docx de docs/copilot/ SÍ se versionan: son la fuente de verdad de las
# instrucciones desplegadas en Copilot Studio (se editan directo, no por generador).
# Los .docx de arquitectura son regenerables con tools/ → se ignoran.
docs/arquitectura/*.docx
# Presentación de gerencia: pesada y no necesaria en el repo.
docs/gerencia/
# PDFs de pruebas: pesados y regenerables desde el .docx (Word/LibreOffice).
docs/pruebas/*.pdf
