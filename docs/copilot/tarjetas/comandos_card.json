{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "🛠️ Comandos KomfIA",
      "weight": "Bolder",
      "size": "Large",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Escribe **/** + módulo + parámetros.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Small",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "📖 Cómo leer los comandos",
          "weight": "Bolder",
          "size": "Small",
          "spacing": "None"
        },
        {
          "type": "FactSet",
          "spacing": "Small",
          "facts": [
            {
              "title": "‹campo›",
              "value": "OBLIGATORIO"
            },
            {
              "title": "[campo]",
              "value": "opcional (tiene un valor por defecto)"
            },
            {
              "title": "‹proj›",
              "value": "proyecto / mina — ej. Antapaccay, Antamina"
            },
            {
              "title": "‹eq›",
              "value": "equipo — ej. CA3177 (traduce «el 3177»)"
            },
            {
              "title": "‹comp›",
              "value": "componente — tracción · hidráulico · rueda · mando · transmisión · motor"
            },
            {
              "title": "‹metal›",
              "value": "metal — Fe, Cu, Cr, Ni, Pb, Sn, Si, PQ, Na, K… (o su nombre)"
            },
            {
              "title": "[modelo]",
              "value": "modelo — ej. 980E (por defecto: todos)"
            },
            {
              "title": "[top]",
              "value": "cuántos mostrar (por defecto: 10)"
            }
          ]
        }
      ]
    },
    {
